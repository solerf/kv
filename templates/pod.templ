package templates

templ PodDetail(context, namespace, name string) {
	@Layout("kv - " + name) {
		<nav class="navbar neo-header d-flex align-items-center">
			<span class="navbar-brand fw-bold m-0">kv</span>
			<div class="ms-auto d-flex gap-2 align-items-center">
				<a class="btn neo-btn-light" href={ templ.SafeURL("/?context=" + context + "&namespace=" + namespace) }>Back</a>
				<button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
					<i class="bi bi-sun-fill"></i>
				</button>
			</div>
		</nav>
		<div class="container-fluid mt-2 px-3">
			<div class="d-flex align-items-center justify-content-between mb-2">
				<div>
					<h2 class="mb-0">{ name }</h2>
					<small class="text-muted">{ context } / { namespace }</small>
				</div>
				<div class="d-flex gap-2 align-items-center">
					<button id="btn-logs" class="btn neo-btn-light">Stream Logs</button>
					<button id="btn-delete" class="btn neo-btn-danger" disabled>Delete Pod</button>
					<label class="form-check-label d-flex align-items-center gap-1 ms-1">
						<input type="checkbox" id="enable-delete" class="form-check-input m-0"/>
						<small>Enable</small>
					</label>
				</div>
			</div>
			<div class="row mb-2">
				<div class="col-12">
					<div class="neo-card p-2">
						<h5 class="mb-2">Pod Information</h5>
						<div class="row">
							<div class="col-md-6">
								<small class="text-muted d-block mb-1">Status: <span id="pod-status">-</span></small>
								<small class="text-muted d-block mb-1">Image: <span id="pod-image">-</span></small>
								<small class="text-muted d-block mb-1">IP: <span id="pod-ip">-</span></small>
							</div>
							<div class="col-md-6">
								<small class="text-muted d-block mb-1">Node: <span id="pod-node">-</span></small>
								<small class="text-muted d-block mb-1">Age: <span id="pod-age">-</span></small>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row mb-2">
				<div class="col-md-6 mb-2">
					<div class="neo-card p-2">
						<h5 class="mb-1">CPU (millicores)</h5>
						<canvas id="cpu-chart"></canvas>
					</div>
				</div>
				<div class="col-md-6 mb-2">
					<div class="neo-card p-2">
						<h5 class="mb-1">Memory (MB)</h5>
						<canvas id="mem-chart"></canvas>
					</div>
				</div>
			</div>
			<div class="mb-2">
				<h4 class="mb-2">Describe</h4>
				<pre id="describe-output" class="yaml-output">Loading...</pre>
			</div>
		</div>
		<div class="modal fade" id="logs-modal" tabindex="-1">
			<div class="modal-dialog modal-xl modal-dialog-scrollable">
				<div class="modal-content neo-modal">
					<div class="modal-header">
						<h5 class="modal-title">Logs: { name }</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<pre id="logs-output" class="yaml-output"></pre>
					</div>
				</div>
			</div>
		</div>
		<input type="hidden" id="pod-context" value={ context }/>
		<input type="hidden" id="pod-namespace" value={ namespace }/>
		<input type="hidden" id="pod-name" value={ name }/>
		@Script("/static/js/pod.js")
	}
}
